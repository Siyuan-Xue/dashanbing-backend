# Copy to .env before the first Compose startup.
BASKETBALL_ADMIN_USERNAME=admin
BASKETBALL_ADMIN_PASSWORD=replace-with-a-long-local-password
BASKETBALL_JWT_SECRET_KEY=replace-with-at-least-32-random-characters
BASKETBALL_COOKIE_SECURE=false
BASKETBALL_SIMULATION_MODE=false
BASKETBALL_WORKER_ENABLED=true
BASKETBALL_MIN_FREE_STORAGE_GB=20

# Container paths; keep these values for docker compose.
BASKETBALL_DATABASE_URL=sqlite:////runtime/app.db
BASKETBALL_RUNTIME_ROOT=/runtime
BASKETBALL_SAMPLE_ROOT=/samples
BASKETBALL_MODEL_ROOT=/models
BASKETBALL_SYNC_CONFIG=/deployment/sync.json
BASKETBALL_FRONTEND_DIST=/app/app/frontend
